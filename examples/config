# ~/.config/cachy-mode/config — sourced by cachy-mode (bash syntax). All optional.

# systemd --user units to stop in Gaming mode (frees their VRAM) and start in Dev mode.
UNITS=(comfyui comfyui-mcp)

# If ComfyUI answers here, Gaming mode refuses while its queue has jobs (use --force / the widget's Force).
COMFY_URL="http://127.0.0.1:8188"

# Companion: a Docker Compose app on another host that sends jobs to this GPU. cachy-mode stops it in
# Gaming mode and starts it in Dev mode; the widget also gets a switch for it. Needs key-based ssh to the host.
#COMPANION_HOST="dh01"
#COMPANION_DIR="~/apps/companion"
